# Neon / Postgres — never commit real credentials.
# Pooled URL for the app (Neon pooler; pgbouncer=true recommended).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# Direct (non-pooler) URL for migrations — Neon Vercel integration names this DATABASE_URL_UNPOOLED.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Demo session HMAC secret — required (≥32 chars, unique) on Vercel/shared deploys.
# Local/dev may omit; production fails closed if missing or using a weak default.
SESSION_SECRET="replace-with-a-long-unique-random-secret"
