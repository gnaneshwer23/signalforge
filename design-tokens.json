{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "SignalForge — forest green + scientific teal (public + workbench)",
  "version": "3.0.0",
  "reference": {
    "url": "https://dribbble.com/shots/27696621-Pharma-Biotech-Website-UI-UX-Medical-research-homepage-design",
    "shotId": "27696621",
    "bionilNotes": "Deep forest green + scientific teal; warm white / pale mint grounds; amber for attention. Inspiration only — no third-party assets copied.",
    "note": "Inspiration only. Do not copy shot assets, photography, 3D art, or branding."
  },
  "fonts": {
    "display": {
      "family": "Source Serif 4",
      "source": "google",
      "cssVariable": "--font-display",
      "fallbacks": ["ui-serif", "Georgia", "serif"],
      "usage": "Marketing / editorial major headings and brand wordmark on public pages"
    },
    "body": {
      "family": "Plus Jakarta Sans",
      "source": "google",
      "cssVariable": "--font-body",
      "fallbacks": ["ui-sans-serif", "sans-serif"],
      "usage": "App UI, tables, forms, nav, body copy"
    },
    "mono": {
      "family": "Geist Mono",
      "source": "google",
      "cssVariable": "--font-geist-mono",
      "fallbacks": ["ui-monospace", "monospace"]
    },
    "avoid": ["Inter", "Roboto", "Arial", "system-ui"]
  },
  "colors": {
    "paper": "#F7FAF6",
    "background": "#E8F2EC",
    "surface": "#FFFFFF",
    "surfaceMuted": "#D8E8DE",
    "mint": "#E8F5EF",
    "forest": "#0F3D2E",
    "forestDeep": "#0A2E22",
    "teal": "#1A7A6D",
    "tealSoft": "#2A9B8C",
    "ink": "#14241C",
    "muted": "#4F655A",
    "border": "#C5D9CE",
    "input": "#BDD2C6",
    "primary": "#0F3D2E",
    "primaryForeground": "#F7FAF6",
    "primaryDeep": "#0A2E22",
    "secondary": "#D4E8DC",
    "accent": "#C5E4DB",
    "accentSignal": "#1A7A6D",
    "ring": "#1A7A6D",
    "amber": "#B45309",
    "status": {
      "verified": "#1A7A6D",
      "needsReview": "#B45309",
      "unverified": "#4F655A",
      "danger": "#B42318"
    },
    "chart": ["#1A7A6D", "#0F3D2E", "#B45309", "#3D8B7A", "#A8CFC0"]
  },
  "cssVariableMap": {
    "--paper": "paper",
    "--background": "background",
    "--card": "surface",
    "--muted": "surfaceMuted",
    "--mint": "mint",
    "--forest": "forest",
    "--teal": "teal",
    "--ink": "ink",
    "--foreground": "ink",
    "--muted-foreground": "muted",
    "--border": "border",
    "--input": "input",
    "--primary": "primary",
    "--primary-foreground": "primaryForeground",
    "--secondary": "secondary",
    "--accent": "accent",
    "--accent-signal": "accentSignal",
    "--ring": "ring",
    "--verified": "status.verified",
    "--amber-review": "status.needsReview",
    "--destructive": "status.danger"
  },
  "spacing": {
    "basePx": 4,
    "scale": [4, 8, 12, 16, 24, 32, 48],
    "pagePadding": { "base": 16, "sm": 24, "lg": 32 },
    "sectionGap": 24
  },
  "radius": {
    "base": "0.625rem",
    "sm": "0.375rem",
    "md": "0.625rem",
    "lg": "0.875rem",
    "avoidFullPill": true
  },
  "border": {
    "width": "1px",
    "style": "solid",
    "colorToken": "border"
  },
  "shadow": {
    "panel": "0 1px 2px rgb(15 61 46 / 0.06)",
    "sheet": "0 10px 28px rgb(15 61 46 / 0.1)",
    "glow": "none"
  },
  "motion": [
    {
      "id": "rise-in",
      "description": "Panel enter: opacity + translateY(8px→0)",
      "durationMs": 450,
      "easing": "ease-out"
    },
    {
      "id": "slide-nav",
      "description": "Nav link stagger: opacity + translateX(-6px→0)",
      "durationMs": 400,
      "staggerMs": 30,
      "easing": "ease-out"
    },
    {
      "id": "fade-delay",
      "description": "Secondary band fade-in with delay",
      "durationMs": 550,
      "delayMs": 120,
      "easing": "ease-out"
    }
  ],
  "shells": {
    "marketing": {
      "nav": "top-horizontal",
      "brand": "editorial-serif-wordmark",
      "ctaPrimary": "forest-green"
    },
    "workbench": {
      "nav": "left-sidebar",
      "brand": "serif-wordmark-first",
      "active": "solid-forest-primary"
    }
  },
  "components": {
    "metrics": {
      "style": "open-tile-border",
      "valueFont": "display",
      "label": "uppercase-meta"
    },
    "cards": {
      "default": "none",
      "interactivePanel": "hairline-border-white"
    },
    "tables": {
      "zebra": false,
      "hover": "surfaceMuted",
      "header": "hairline-bottom"
    },
    "chips": {
      "radius": "sm",
      "variants": ["verified", "needs-review", "unverified", "danger"]
    },
    "cta": {
      "primaryRadius": "md",
      "avoidRoundedFull": true
    }
  }
}
