{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "SignalForge — medical research workbench (shot 27696621 inspiration)",
  "version": "2.0.0",
  "reference": {
    "url": "https://dribbble.com/shots/27696621-Pharma-Biotech-Website-UI-UX-Medical-research-homepage-design",
    "shotId": "27696621",
    "note": "Inspiration only. Do not copy shot assets, photography, 3D art, or branding. Direction extracted from rendered capture + pixel sampling (sage field, white planes, charcoal CTAs)."
  },
  "fonts": {
    "display": {
      "family": "Sora",
      "source": "google",
      "cssVariable": "--font-display",
      "fallbacks": ["ui-sans-serif", "sans-serif"]
    },
    "body": {
      "family": "Plus Jakarta Sans",
      "source": "google",
      "cssVariable": "--font-body",
      "fallbacks": ["ui-sans-serif", "sans-serif"]
    },
    "mono": {
      "family": "Geist Mono",
      "source": "google",
      "cssVariable": "--font-geist-mono",
      "fallbacks": ["ui-monospace", "monospace"]
    },
    "avoid": ["Inter", "Roboto", "Arial", "system-ui"]
  },
  "colors": {
    "paper": "#F5F8F4",
    "background": "#E8F0E4",
    "surface": "#FFFFFF",
    "surfaceMuted": "#DDE8D8",
    "sage": "#B5C9AF",
    "ink": "#161A18",
    "muted": "#5A6B62",
    "border": "#C9D6C8",
    "input": "#C5D4C3",
    "primary": "#1A1B22",
    "primaryForeground": "#F5F8F4",
    "primaryDeep": "#0D0E12",
    "secondary": "#D5E4CF",
    "accent": "#C8DCC0",
    "accentSignal": "#3F6B4F",
    "ring": "#3F6B4F",
    "status": {
      "verified": "#3F6B4F",
      "needsReview": "#B45309",
      "unverified": "#5A6B62",
      "danger": "#B42318"
    },
    "chart": ["#3F6B4F", "#1A1B22", "#B45309", "#7A9A7C", "#B5C9AF"]
  },
  "cssVariableMap": {
    "--paper": "paper",
    "--background": "background",
    "--card": "surface",
    "--muted": "surfaceMuted",
    "--sage": "sage",
    "--mint": "sage",
    "--ink": "ink",
    "--foreground": "ink",
    "--muted-foreground": "muted",
    "--border": "border",
    "--input": "input",
    "--primary": "primary",
    "--primary-foreground": "primaryForeground",
    "--secondary": "secondary",
    "--accent": "accent",
    "--ring": "ring",
    "--verified": "status.verified",
    "--amber-review": "status.needsReview",
    "--destructive": "status.danger"
  },
  "spacing": {
    "basePx": 4,
    "scale": [4, 8, 12, 16, 24, 32, 48],
    "pagePadding": { "base": 16, "sm": 24, "lg": 32 },
    "sectionGap": 24
  },
  "radius": {
    "base": "0.625rem",
    "sm": "0.375rem",
    "md": "0.625rem",
    "lg": "0.875rem",
    "avoidFullPill": true
  },
  "border": {
    "width": "1px",
    "style": "solid",
    "colorToken": "border"
  },
  "shadow": {
    "panel": "0 1px 2px rgb(22 26 24 / 0.05)",
    "sheet": "0 10px 28px rgb(22 26 24 / 0.08)",
    "glow": "none"
  },
  "motion": [
    {
      "id": "rise-in",
      "description": "Panel enter: opacity + translateY(8px→0)",
      "durationMs": 450,
      "easing": "ease-out"
    },
    {
      "id": "slide-nav",
      "description": "Nav link stagger: opacity + translateX(-6px→0)",
      "durationMs": 400,
      "staggerMs": 30,
      "easing": "ease-out"
    },
    {
      "id": "fade-delay",
      "description": "Secondary band fade-in with delay",
      "durationMs": 550,
      "delayMs": 120,
      "easing": "ease-out"
    }
  ],
  "components": {
    "nav": {
      "placement": "left-sidebar",
      "active": "solid-charcoal-primary",
      "brand": "display-wordmark-first"
    },
    "metrics": {
      "style": "open-tile-border",
      "valueFont": "display",
      "label": "uppercase-meta"
    },
    "cards": {
      "default": "none",
      "interactivePanel": "hairline-border-white"
    },
    "tables": {
      "zebra": false,
      "hover": "surfaceMuted",
      "header": "hairline-bottom"
    },
    "chips": {
      "radius": "sm",
      "variants": ["verified", "needs-review", "unverified", "danger"]
    },
    "cta": {
      "primaryRadius": "md",
      "avoidRoundedFull": true
    },
    "drawer": {
      "surface": "white",
      "edge": "hairline",
      "shadowToken": "sheet"
    }
  }
}
