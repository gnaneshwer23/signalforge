{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "SignalForge — Chlorophyll Clinical (marketing + workbench)",
  "version": "4.0.0",
  "reference": {
    "urls": [
      "https://dribbble.com/shots/27696621-Pharma-Biotech-Website-UI-UX-Medical-research-homepage-design",
      "https://dribbble.com/shots/22558925-Bionil-Pharma-Factory-Landing-page"
    ],
    "note": "Inspiration only. Original SignalForge system — do not copy shot assets, photography, layouts, or branding."
  },
  "fonts": {
    "display": {
      "family": "Source Serif 4",
      "source": "google",
      "cssVariable": "--font-display",
      "fallbacks": ["ui-serif", "Georgia", "serif"],
      "usage": "Marketing display headlines and brand wordmark ONLY — never workbench page/section titles"
    },
    "body": {
      "family": "Plus Jakarta Sans",
      "source": "google",
      "cssVariable": "--font-body",
      "fallbacks": ["ui-sans-serif", "sans-serif"],
      "usage": "All UI, tables, forms, nav, workbench titles, body copy"
    },
    "mono": {
      "family": "Geist Mono",
      "source": "google",
      "cssVariable": "--font-geist-mono",
      "fallbacks": ["ui-monospace", "monospace"]
    },
    "avoid": ["Inter", "Roboto", "Arial", "system-ui"]
  },
  "colors": {
    "paper": "#F4F8F5",
    "background": "#E6F0EA",
    "surface": "#FFFFFF",
    "surfaceMuted": "#D5E6DB",
    "mint": "#E3F2EB",
    "mintDeep": "#C8E4D6",
    "forest": "#0B3A2C",
    "forestDeep": "#07281E",
    "forestMid": "#145C45",
    "teal": "#117A6B",
    "tealSoft": "#2A9B8A",
    "ink": "#101F18",
    "muted": "#4A5E54",
    "border": "#BFD4C8",
    "input": "#B5CCBF",
    "primary": "#0B3A2C",
    "primaryForeground": "#F4F8F5",
    "primaryDeep": "#07281E",
    "secondary": "#D0E6DA",
    "accent": "#C2E0D6",
    "accentSignal": "#117A6B",
    "ring": "#117A6B",
    "amber": "#A85708",
    "status": {
      "verified": "#117A6B",
      "needsReview": "#A85708",
      "unverified": "#4A5E54",
      "danger": "#A61E14"
    },
    "chart": ["#117A6B", "#0B3A2C", "#A85708", "#2A9B8A", "#9ECFBC"]
  },
  "cssVariableMap": {
    "--paper": "paper",
    "--background": "background",
    "--card": "surface",
    "--muted": "surfaceMuted",
    "--mint": "mint",
    "--forest": "forest",
    "--teal": "teal",
    "--ink": "ink",
    "--foreground": "ink",
    "--muted-foreground": "muted",
    "--border": "border",
    "--input": "input",
    "--primary": "primary",
    "--primary-foreground": "primaryForeground",
    "--secondary": "secondary",
    "--accent": "accent",
    "--accent-signal": "accentSignal",
    "--ring": "ring",
    "--verified": "status.verified",
    "--amber-review": "status.needsReview",
    "--destructive": "status.danger"
  },
  "spacing": {
    "basePx": 4,
    "scale": [4, 8, 12, 16, 24, 32, 48, 64],
    "pagePadding": { "base": 16, "sm": 24, "lg": 32 },
    "sectionGap": 24,
    "workbenchDensity": "compact-readable"
  },
  "radius": {
    "base": "0.5rem",
    "sm": "0.375rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "avoidFullPill": true
  },
  "border": {
    "width": "1px",
    "style": "solid",
    "colorToken": "border"
  },
  "shadow": {
    "panel": "0 1px 2px rgb(11 58 44 / 0.05)",
    "sheet": "0 8px 24px rgb(11 58 44 / 0.08)",
    "glow": "none"
  },
  "motion": [
    {
      "id": "rise-in",
      "description": "Panel enter: opacity + translateY(6px→0)",
      "durationMs": 400,
      "easing": "cubic-bezier(0.22, 1, 0.36, 1)"
    },
    {
      "id": "slide-nav",
      "description": "Nav link stagger: opacity + translateX(-4px→0)",
      "durationMs": 350,
      "staggerMs": 25,
      "easing": "ease-out"
    },
    {
      "id": "fade-delay",
      "description": "Secondary band fade-in with delay",
      "durationMs": 500,
      "delayMs": 100,
      "easing": "ease-out"
    }
  ],
  "shells": {
    "marketing": {
      "nav": "top-horizontal",
      "brand": "editorial-serif-wordmark",
      "ctaPrimary": "forest-green",
      "displayFont": true
    },
    "workbench": {
      "nav": "left-sidebar",
      "brand": "serif-wordmark-only",
      "titles": "geometric-sans",
      "active": "solid-forest-primary",
      "density": "data-forward"
    }
  },
  "components": {
    "metrics": {
      "style": "open-tile-border",
      "valueFont": "body-semibold",
      "label": "uppercase-meta"
    },
    "cards": {
      "default": "none",
      "interactivePanel": "hairline-border-white"
    },
    "tables": {
      "zebra": false,
      "hover": "surfaceMuted",
      "header": "hairline-bottom",
      "mobile": "horizontal-scroll"
    },
    "chips": {
      "radius": "sm",
      "variants": ["verified", "needs-review", "unverified", "danger"]
    },
    "cta": {
      "primaryRadius": "md",
      "avoidRoundedFull": true
    }
  }
}
