{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "SignalForge — Bionil-inspired clinical workbench",
  "version": "1.0.0",
  "reference": {
    "url": "https://dribbble.com/shots/22558925-Bionil-Pharma-Factory-Landing-page",
    "shotId": "22558925",
    "note": "Inspiration only. Do not copy Bionil assets, illustrations, or branding."
  },
  "fonts": {
    "display": {
      "family": "Fraunces",
      "source": "google",
      "cssVariable": "--font-display",
      "fallbacks": ["ui-serif", "Georgia", "serif"]
    },
    "body": {
      "family": "Source Sans 3",
      "source": "google",
      "cssVariable": "--font-body",
      "fallbacks": ["ui-sans-serif", "sans-serif"]
    },
    "mono": {
      "family": "Geist Mono",
      "source": "google",
      "cssVariable": "--font-geist-mono",
      "fallbacks": ["ui-monospace", "monospace"],
      "alternate": "IBM Plex Mono"
    },
    "avoid": ["Inter", "Roboto", "Arial", "system-ui"]
  },
  "colors": {
    "paper": "#F4FAF7",
    "background": "#EEF7F2",
    "surface": "#FFFFFF",
    "surfaceMuted": "#E4F2EB",
    "mint": "#D8EFE6",
    "ink": "#14352C",
    "muted": "#4A6B5F",
    "border": "#C5DDD2",
    "input": "#C9E0D6",
    "primary": "#0F6B52",
    "primaryForeground": "#F4FAF7",
    "primaryDeep": "#0A4A3A",
    "secondary": "#DCEEE6",
    "accent": "#D2EBE1",
    "ring": "#0F6B52",
    "status": {
      "verified": "#0F6B52",
      "needsReview": "#B45309",
      "unverified": "#4A6B5F",
      "danger": "#B42318"
    },
    "chart": ["#0F6B52", "#1A8A6A", "#B45309", "#2D5A4C", "#7A9A8C"]
  },
  "cssVariableMap": {
    "--paper": "paper",
    "--background": "background",
    "--card": "surface",
    "--muted": "surfaceMuted",
    "--mint": "mint",
    "--ink": "ink",
    "--foreground": "ink",
    "--muted-foreground": "muted",
    "--border": "border",
    "--input": "input",
    "--primary": "primary",
    "--primary-foreground": "primaryForeground",
    "--secondary": "secondary",
    "--accent": "accent",
    "--ring": "ring",
    "--verified": "status.verified",
    "--amber-review": "status.needsReview",
    "--destructive": "status.danger"
  },
  "spacing": {
    "basePx": 4,
    "scale": [4, 8, 12, 16, 24, 32, 48],
    "pagePadding": { "base": 16, "sm": 24, "lg": 32 },
    "sectionGap": 24
  },
  "radius": {
    "base": "0.375rem",
    "sm": "0.25rem",
    "md": "0.375rem",
    "lg": "0.5rem",
    "avoidFullPill": true
  },
  "border": {
    "width": "1px",
    "style": "solid",
    "colorToken": "border"
  },
  "shadow": {
    "panel": "0 1px 2px rgb(20 53 44 / 0.04)",
    "sheet": "0 8px 24px rgb(20 53 44 / 0.08)",
    "glow": "none"
  },
  "motion": [
    {
      "id": "rise-in",
      "description": "Panel enter: opacity + translateY(8px→0)",
      "durationMs": 450,
      "easing": "ease-out"
    },
    {
      "id": "slide-nav",
      "description": "Nav link stagger: opacity + translateX(-6px→0)",
      "durationMs": 400,
      "staggerMs": 30,
      "easing": "ease-out"
    },
    {
      "id": "fade-delay",
      "description": "Secondary band fade-in with delay",
      "durationMs": 550,
      "delayMs": 120,
      "easing": "ease-out"
    }
  ],
  "components": {
    "nav": {
      "placement": "left-sidebar",
      "active": "solid-primary",
      "brand": "display-wordmark-first"
    },
    "metrics": {
      "style": "open-tile-border",
      "valueFont": "display",
      "label": "uppercase-meta"
    },
    "cards": {
      "default": "none",
      "interactivePanel": "hairline-border-white"
    },
    "tables": {
      "zebra": false,
      "hover": "surfaceMuted",
      "header": "hairline-bottom"
    },
    "chips": {
      "radius": "sm",
      "variants": ["verified", "needs-review", "unverified", "danger"]
    },
    "cta": {
      "primaryRadius": "md",
      "avoidRoundedFull": true
    },
    "drawer": {
      "surface": "white",
      "edge": "hairline",
      "shadowToken": "sheet"
    }
  }
}
